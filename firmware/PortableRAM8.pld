Name     PortableRAM8 ;
PartNo   ATF1502ASL-25AU44 ;
Date     2026-07-26 ;
Revision 02 ;
Designer G. Campbell ;
Company  - ;
Assembly Mac Portable 8MB RAM Card v3.0 ;
Location U1 ;
Device   f1502isptqfp44 ;

/*
 * Macintosh Portable 8MB SRAM expansion - address decode + control (v3)
 *
 * Memory: 8x AS6C8008 (1Mx8, 5V) = 4 banks x 2MB (1Mx16) filling the
 * expansion window 0x100000-0x8FFFFF. Total system RAM: 9MB (max) on M5120.
 * 2MB banks straddle even-MB boundaries (window starts at 1MB). Decode
 * by 1MB page (A23:A20 = 1..8): CE0=pages1-2 ... CE3=pages7-8. Within a
 * bank, BANKSEL (= !A20) drives SRAM A19 (pin 18) to pick the page half.
 * Chip A0-A18 = Mac A1-A19. AS6C8008 pin 40 (CS2, active-high enable)
 * tied to +5V on the board.
 *
 * CYCLE TIMING - qualified by the DATA STROBES (UDS*, LDS*), NOT AS*.
 * The Portable's RAM-expansion connector brings out R/W, UDS*, LDS* and
 * the address bus, but NOT AS* and NOT a sleep/SYS_PWR line (verified
 * against Apple 050-0219; AS* and pwr_dwn stay on-board feeding the
 * refresh controller). The proven discrete-logic reference card decodes
 * the same way - A20-A23 + UDS*, LDS* + R/W, no AS*, no sleep. CPLD pins
 * 2/6/11 are wired to pulled-up nets (/AS, /DELAY_CS, /SLEEP) that the
 * connector does not drive; declared here for documentation but UNUSED.
 *
 * DTACK: driven by this card via pins 23 (/DTACK) and 31 (/EXT_DTACK).
 * Both are routed to J3 (1x2 2.54mm header on the board edge). User connects
 * a wire from J3 pin 1 to PDS slot pin B7 (/DTACK) to bypass the GLU entirely.
 * J3 pin 2 (EXT_DTACK -> PDS B30) is optional. Both outputs are tristated when
 * not our cycle (DTACK.OE = active) to avoid contention with GLU on the shared
 * /DTACK line. Logic is purely combinatorial - immune to sleep/wake state loss.
 *
 * WE is split per byte lane: pin 28 (/WE) -> low byte U2-U5 (gated LDS),
 * pin 30 (/WEH) -> high byte U6-U9 (gated UDS). A common WE would corrupt
 * the partner byte on 68000 byte writes.
 *
 * MODEL jumper (JP1 -> pin 34, 10K pull-up to +5V):
 *   OPEN  = MODEL high = M5120 (non-backlit): all 4 banks active, 8MB
 *           expansion = 9MB total system RAM.
 *   CLOSED= MODEL low  = M5126 (backlit): bank 3 (0x700000-0x8FFFFF)
 *           gated off, 6MB expansion = 7MB total. Avoids SLOT_CS0
 *           conflict at 0x800000 on backlit models.
 *
 * BANK POPULATION: banks are populated sequentially from bank 0 (U2+U6).
 * Ghost RAM prevention: 10K pull-downs on data bus (SRAM side of 74HC245)
 * ensure unpopulated banks return 0x0000 so Mac boot sizing halts cleanly.
 *
 * STATUS LEDs (LED0-LED3, green): registered outputs that latch ON when the
 * Mac's boot RAM probe first accesses each bank. Power-cycle clears them.
 * LED on = Mac found and sized that bank successfully at boot.
 *
 * JTAG: pins 1(TDI) 7(TMS) 26(TCK) 32(TDO) - keep JTAG enabled in the
 * fitter or you lock yourself out of the chip.
 */

PROPERTY ATMEL { jtag = on }; /* keep JTAG pins live for re-programming via Tigard */

/* ---------- inputs (from connector) ---------- */
PIN 3  = RW       ; /* 68000 R/W: high = read, low = write   */
PIN 8  = !UDS     ; /* upper data strobe (D8-15), active low  */
PIN 10 = !LDS     ; /* lower data strobe (D0-7), active low   */
PIN 12 = A20      ;
PIN 13 = A21      ;
PIN 14 = A22      ;
PIN 15 = A23      ;
PIN 34 = MODEL    ; /* model jumper: high(open)=M5120 full 8MB, low(closed)=M5126 cap 6MB */

/* ---------- inputs present on CPLD but NOT driven by connector ----------
 * (pulled up on-board; left unused - see header)                         */
PIN 2  = !AS      ; /* NOT on connector - unused */
PIN 6  = DELAY_CS ; /* NOT on connector - unused */
PIN 11 = !SLEEP   ; /* NOT on connector - unused */

/* ---------- outputs ---------- */
PIN 18 = !CE0     ; /* bank 0: U2+U6 */
PIN 19 = !CE1     ; /* bank 1: U3+U7 */
PIN 20 = !CE2     ; /* bank 2: U4+U8 */
PIN 21 = !CE3     ; /* bank 3: U5+U9 */
PIN 22 = !OE      ; /* common SRAM output enable */
PIN 25 = DIR      ; /* '245 direction (see DIR equation) */
PIN 27 = !DOE     ; /* '245 output enable, both transceivers */
PIN 28 = !WEL     ; /* write enable, LOW byte chips U2-U5  */
PIN 30 = !WEH     ; /* write enable, HIGH byte chips U6-U9 */
PIN 23 = !DTACK     ; /* -> J3 pin 1 -> PDS B7: drive /DTACK to 68000, bypass GLU */
PIN 31 = !EXT_DTACK ; /* -> J3 pin 2 -> PDS B30: optional second DTACK output */
PIN 33 = BANKSEL  ; /* bank-half select -> SRAM A19 (pin 18, all chips) */

/* ---------- registered LED outputs (latch on first bank access at boot) -- */
/* NOTE: pins 37/38/39/40 are dedicated input-only pins on ATF1502 TQFP-44  */
/* and cannot be used as outputs. LED1/2/3 moved to Block A pins 42/43/44.  */
PIN 35 = LED0     ; /* bank 0 status: green LED, latches on at boot probe   */
PIN 42 = LED1     ; /* bank 1 status -- was pin 37 (dedicated input, invalid) */
PIN 43 = LED2     ; /* bank 2 status -- was pin 38 (dedicated input, invalid) */
PIN 44 = LED3     ; /* bank 3 status -- was pin 39 (dedicated input, invalid) */

/* ---------- intermediate terms ---------- */
page1 = !A23 & !A22 & !A21 &  A20 ;        /* 0x1xxxxx */
page2 = !A23 & !A22 &  A21 & !A20 ;        /* 0x2xxxxx */
page3 = !A23 & !A22 &  A21 &  A20 ;        /* 0x3xxxxx */
page4 = !A23 &  A22 & !A21 & !A20 ;        /* 0x4xxxxx */
page5 = !A23 &  A22 & !A21 &  A20 ;        /* 0x5xxxxx */
page6 = !A23 &  A22 &  A21 & !A20 ;        /* 0x6xxxxx */
page7 = !A23 &  A22 &  A21 &  A20 ;        /* 0x7xxxxx */
page8 =  A23 & !A22 & !A21 & !A20 ;        /* 0x8xxxxx */

sel0 = page1 # page2 ;                     /* bank 0: 0x100000-0x2FFFFF */
sel1 = page3 # page4 ;                     /* bank 1: 0x300000-0x4FFFFF */
sel2 = page5 # page6 ;                     /* bank 2: 0x500000-0x6FFFFF */
sel3 = page7 # page8 ;                     /* bank 3: 0x700000-0x8FFFFF */

strobe = UDS # LDS ;                       /* any byte lane active = valid cycle */
ramsel = sel0 # sel1 # sel2 # (MODEL & sel3) ;
active = ramsel & strobe ;                 /* our space, qualified by data strobe */

/* ---------- equations ---------- */
CE0 = sel0 & strobe ;
CE1 = sel1 & strobe ;
CE2 = sel2 & strobe ;
CE3 = MODEL & sel3 & strobe ;              /* gated off for M5126 (MODEL=low) */

OE  = active &  RW ;                       /* output enable on reads (both bytes drive;
                                              CPU ignores the un-strobed lane) */
WEL = active & LDS & !RW ;                 /* low byte write  */
WEH = active & UDS & !RW ;                 /* high byte write */

DIR = !RW ;                                /* A-side=bus, B-side=SRAM:
                                              read (RW=1) -> DIR low -> B->A -> SRAM->bus
                                              write(RW=0) -> DIR high-> A->B -> bus->SRAM */
DOE = active ;                             /* transceivers on during our access */

BANKSEL = !A20 ;                           /* odd pages = low half of bank */

/* ---------- DTACK equations -- */
/* Tristate when not our cycle; assert when address falls in our window      */
/* and a data strobe is active. Purely combinatorial - no state to lose on   */
/* sleep/wake.                                                                */
EXT_DTACK.OE = active ;
EXT_DTACK    = active ;
DTACK.OE     = active ;
DTACK        = active ;

/* ---------- LED latch equations (registered macrocell, D=1, CK=access) -- */
/* Power-on clears all flip-flops. First bus access to each bank clocks      */
/* D=1 into the output and it stays high until next power cycle.             */
LED0.D  = 'b'1 ;  LED0.CK = sel0 & strobe ;
LED1.D  = 'b'1 ;  LED1.CK = sel1 & strobe ;
LED2.D  = 'b'1 ;  LED2.CK = sel2 & strobe ;
LED3.D  = 'b'1 ;  LED3.CK = MODEL & sel3 & strobe ;
